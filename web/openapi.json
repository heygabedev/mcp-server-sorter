  "components": {
    "schemas": {
      "CaseResult": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "intent_id": {
            "type": "string",
            "title": "Intent Id"
          },
          "split": {
            "type": "string",
            "title": "Split"
          },
          "result_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Result Ids"
          },
          "metrics": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Metrics"
          },
          "constraint_violations": {
            "type": "integer",
            "title": "Constraint Violations"
          },
          "invalid_evidence_references": {
            "type": "integer",
            "title": "Invalid Evidence References"
          },
          "abstention_correct": {
            "type": "boolean",
            "title": "Abstention Correct"
          },
          "expected_top_correct": {
            "type": "boolean",
            "title": "Expected Top Correct"
          },
          "fallback": {
            "type": "boolean",
            "title": "Fallback"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          },
          "model_metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Model Metadata"
          }
        },
        "type": "object",
        "required": [
          "id",
          "intent_id",
          "split",
          "result_ids",
          "metrics",
          "constraint_violations",
          "invalid_evidence_references",
          "abstention_correct",
          "expected_top_correct",
          "fallback",
          "latency_ms"
        ],
        "title": "CaseResult"
      },
      "CollectionRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Ids"
          },
          "snapshot": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot"
          }
        },
        "type": "object",
        "required": ["name", "ids"],
        "title": "CollectionRequest"
      },
      "CompareRequest": {
        "properties": {
          "ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 4,
            "minItems": 2,
            "title": "Ids"
          },
          "snapshot": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot"
          }
        },
        "type": "object",
        "required": ["ids"],
        "title": "CompareRequest"
      },
      "EvaluationReport": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "title": "Schema Version",
            "default": 1
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "dataset_version": {
            "type": "string",
            "title": "Dataset Version"
          },
          "dataset_sha256": {
            "type": "string",
            "title": "Dataset Sha256"
          },
          "source_sha256": {
            "type": "string",
            "title": "Source Sha256"
          },
          "execution_mode": {
            "type": "string",
            "title": "Execution Mode",
            "default": "fixture"
          },
          "profile": {
            "type": "string",
            "title": "Profile",
            "default": "baseline"
          },
          "provenance": {
            "additionalProperties": true,
            "type": "object",
            "title": "Provenance"
          },
          "cases": {
            "items": {
              "$ref": "#/components/schemas/CaseResult"
            },
            "type": "array",
            "title": "Cases"
          },
          "summary": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Summary"
          },
          "slices": {
            "additionalProperties": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            "type": "object",
            "title": "Slices"
          },
          "notice": {
            "type": "string",
            "title": "Notice",
            "default": "Fixture regression results. Live model quality is unmeasured."
          }
        },
        "type": "object",
        "required": [
          "id",
          "dataset_version",
          "dataset_sha256",
          "source_sha256",
          "provenance",
          "cases",
          "summary"
        ],
        "title": "EvaluationReport"
      },
      "EvaluationRequest": {
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "baseline",
              "demo-balanced",
              "demo-fast",
              "demo-timeout",
              "demo-malformed",
              "demo-rate-limited",
              "demo-unavailable",
              "openrouter",
              "litellm"
            ],
            "title": "Profile",
            "default": "baseline"
          }
        },
        "type": "object",
        "title": "EvaluationRequest"
      },
      "Evidence": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 150,
            "pattern": "^[a-z0-9._-]+$",
            "title": "Id"
          },
          "url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Url"
          },
          "statement": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "title": "Statement"
          },
          "kind": {
            "type": "string",
            "enum": ["fixture", "registry", "repository", "probe"],
            "title": "Kind"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "url", "statement", "kind"],
        "title": "Evidence"
      },
      "Filters": {
        "properties": {
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "transport": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["stdio", "streamable-http", "unknown"]
              },
              {
                "type": "null"
              }
            ],
            "title": "Transport"
          },
          "auth": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["none", "api_key", "oauth", "unknown"]
              },
              {
                "type": "null"
              }
            ],
            "title": "Auth"
          },
          "deployment": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["local", "remote", "unknown"]
              },
              {
                "type": "null"
              }
            ],
            "title": "Deployment"
          },
          "license": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "License"
          },
          "include_deprecated": {
            "type": "boolean",
            "title": "Include Deprecated",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Filters"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "RankRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 500,
            "title": "Query",
            "default": ""
          },
          "filters": {
            "$ref": "#/components/schemas/Filters"
          },
          "snapshot": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Snapshot"
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 20
          },
          "profile": {
            "type": "string",
            "enum": [
              "baseline",
              "demo-balanced",
              "demo-fast",
              "demo-timeout",
              "demo-malformed",
              "demo-rate-limited",
              "demo-unavailable",
              "openrouter",
              "litellm"
            ],
            "title": "Profile",
            "default": "baseline"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RankRequest"
      },
      "RankedServer": {
        "properties": {
          "server": {
            "$ref": "#/components/schemas/ServerRecord"
          },
          "relevance": {
            "type": "number",
            "title": "Relevance"
          },
          "reasons": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reasons"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          }
        },
        "type": "object",
        "required": ["server", "relevance", "reasons", "evidence_ids"],
        "title": "RankedServer"
      },
      "Ranking": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "title": "Schema Version",
            "default": 1
          },
          "application_version": {
            "type": "string",
            "title": "Application Version",
            "default": "0.1.0"
          },
          "snapshot": {
            "type": "string",
            "title": "Snapshot"
          },
          "as_of": {
            "type": "string",
            "title": "As Of"
          },
          "policy_version": {
            "type": "string",
            "title": "Policy Version",
            "default": "bm25-evidence-v1"
          },
          "sqlite_version": {
            "type": "string",
            "title": "Sqlite Version",
            "default": "3.50.4"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "deterministic"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "filters": {
            "$ref": "#/components/schemas/Filters"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/RankedServer"
            },
            "type": "array",
            "title": "Results"
          },
          "fallback_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallback Reason"
          },
          "model_metadata": {
            "additionalProperties": true,
            "type": "object",
            "title": "Model Metadata"
          }
        },
        "type": "object",
        "required": ["snapshot", "as_of", "query", "filters", "results"],
        "title": "Ranking"
      },
      "Selection": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "snapshot": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Snapshot"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "servers": {
            "items": {
              "$ref": "#/components/schemas/ServerRecord"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Servers"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": ["id", "name", "snapshot", "created_at", "servers"],
        "title": "Selection"
      },
      "SelectionExport": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Content Sha256"
          },
          "selection": {
            "$ref": "#/components/schemas/Selection"
          }
        },
        "additionalProperties": false,
