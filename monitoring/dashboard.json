{
  "title": "MCP Server Sorter",
  "uid": "mcp-sorter",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "HTTP p95 seconds", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum(rate(sorter_request_seconds_bucket[5m])) by (le))"}]},
    {"id": 2, "type": "timeseries", "title": "Jobs by state", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "sorter_jobs", "legendFormat": "{{status}}"}]},
    {"id": 3, "type": "timeseries", "title": "Request rate by status", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "rate(sorter_requests_total[5m])", "legendFormat": "{{status}}"}]},
    {"id": 4, "type": "stat", "title": "Fallbacks in retained event window", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"refId": "A", "expr": "sorter_recent_fallbacks"}]}
  ]
}
